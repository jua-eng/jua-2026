    characterSequence: "E \uD0A4\uB85C \uCC3D \uC885\uB8CC\uC545\uB839 \uD1F4\uCE58
      \uAC80\uC0AC \uBC31\uD574\uC601\uC778\uAC04\uB4E4\uC758 \uC545\uD55C \uC6D0\uD55C\uC744
      \uC774\uB8E8\uC9C0 \uBABB\uD574 \uC9C0\uC0C1\uC5D0 \uD604\uC0C1\uC73C\uB85C\uC5B4\uB290\uB0A0\uBD80\uD134\uAC00
      \uC0AC\uB78C\uB4E4\uC758 \uC783\uC5B4\uBC84\uB9B0 \uAE30\uC5B5\uACFC \uCD94\uC5B5\uC774\_\uC6B0\uD3B8
      \uBC30\uB2EC\uBD80 \uC624\uB378\uB9AC\uC544\uC624\uC0B0\uB300\uD559\uAD50\uD398
      ssja@gmail.com\uC2E0\uC8FC\uC544 \uAC1C\uC778 \uC791\uC5C5\uBB3C \uC804\uC2DC\uD68C\n\uB514\uC790\uC778
      \uCF58\uD150\uB4DC \uB514\uC790\uC778 \uD559\uACFC\uC2E0\uC8FC\uC544\uC5F0\uB77D\uCC98:\n\uC138\uACC4\uAD00\uACFC
      \uC5B4\uC6B8\uB9AC\uB294 \uCE90\uB9AD\uD130 \uB514\uC790\uC778\uACFC\n\uCEE8\uC149\uC544\uD2B8\uB97C
      \uADF8\uB9AC\uB294 \uC77C\uB7EC\uC2A4\uD2B8\uB808\uC774\uD130\n\uD3B8\uC9C0\uC758
      \uD615\uD0DC\uB85C \uB9CC\uB4E4\uC5B4\uC9C0\uAE30 \uC2DC\uC791\uD588\uB2E4\n\uC624\uB378\uB9AC\uC544\uB294
      \uC0AC\uB78C\uB4E4\uC758 \uC783\uC5B4\uBC84\uB9B0 \uAE30\uC5B5\uACFC \uCD94\uC5B5\uC744
      \n\uB418\uCC3E\uC544\uC8FC\uAE30 \uC704\uD574 \uC9C0\uC815\uBC1B\uC740\_\uD3B8\uC9C0\uB4E4\uC744
      \uAC00\uC9C0\uACE0 \n\uC0AC\uB78C\uB4E4\uC744 \uCC3E\uC544 \uC804\uB2EC\uD558\uB358
      \uB3C4\uC911\_\n\uC8FC\uC18C\uAC00 \uC801\uD788\uC9C0 \uC54A\uC740 \uC758\uBB38\uC758
      \uD3B8\uC9C0\uB97C \uBC1B\uAC8C \uB418\uACE0,\_\n\uC9C0\uC815\uBC1B\uC740\_\uC774\uC0C1
      \uBC18\uB4DC\uC2DC \uC804\uB2EC\uC744 \uD574\uC57C \uD55C\uB2E4\uB294\_\n\uB9C9\uBB34\uAC00\uB0B4\uC758
      \uBA85\uB839 \uD0D3\uC5D0\_\uC5B4\uCA54 \uC218 \uC5C6\uC774 \uD3B8\uC9C0\uB97C
      \n\uC5F4\uC5B4\uBCF4\uC790,\_\uD3B8\uC9C0 \uC18D\uC758 \uAE30\uC5B5\uB4E4\uC774
      \uC138\uACC4\_\n\uACF3\uACF3\uC73C\uB85C \uD37C\uC838\uAC00\uAC8C \uB418\uB294
      \uC0AC\uAC74\uC774 \uD130\uC9C0\uACE0 \uB9CC\uB2E4.\_\n\uAE30\uC5B5\uB4E4\uC744
      \uB418\uCC3E\uAE30 \uC704\uD574 \uC624\uB378\uB9AC\uC544\uB294 \uD769\uC5B4\uC9C4
      \uAE30\uC5B5\uB4E4\uC774\_\n\uC788\uB294\_\uACF3\uC744 \uCC3E\uC544 \uB2E4\uB2C8\uB294
      \uB3C4\uC911 \uC774\uC0C1\uD558\uAC8C\uB3C4 \n\uAE30\uC5B5\uB4E4\uC758 \uC7A5\uC18C\uB4E4\uC5D0
      \uC775\uC219\uD568\uC744 \uB290\uB07C\uAC8C \uB418\uB294\uB370-...\n\uB0A8\uC544\uC788\uAC8C
      \uB41C \uAC83\uC774 \uC545\uB839. \n\uADF8\uB7F0 \uC545\uB839\uB4E4\uC774 \uC138\uACC4
      \uACF3\uACF3\uC5D0 \uC0DD\uACA8\uB098\uBA70 \uC0AC\uB78C\uB4E4\uC744 \uAD34\uB86D\uD788\uC790\n\uC815\uBD80\uC5D0\uC120
      \uC545\uB839\uB4E4\uC744 \uD1F4\uCE58\uD558\uB294 \uACF5\uBB34\uC6D0 \n\uD1F4\uB9C8\uC0AC
      \uAE30\uC5C5\uC744 \uB9CC\uB4E0\uB2E4.\n\uC5B4\uB9B4 \uB54C\uBD80\uD130 \uC545\uB839\uB9CC\uC774
      \uC544\uB2CC \uADC0\uC2E0\uB4E4\uC744 \uBCF4\uACE0 \uC790\uB77C\uB358\n\uBC31\uD574\uC601\uC740
      \uBB34\uB2F9\uC758 \uC2E0\uAE30\uB97C \uC774\uC5B4\uBC1B\uC9C0 \uC54A\uAE30
      \uC704\uD574\n\uB3C4\uB9DD\uCE58\uB4EF \uD1F4\uB9C8\uC0AC\uB85C \uCDE8\uC5C5\uD558\uAC8C
      \uB418\uACE0, \uCCAB \uC5C5\uBB34\uB97C \uBC1B\uC740 \uB0A0\n\uAE38\uC744 \uC783\uC740
      \uB4EF\uD574 \uBCF4\uC774\uB294 \uB450 \uC18C\uB144, \uC18C\uB140 \uADC0\uC2E0\uB4E4\uC744\n\uB9CC\uB098\uAC8C
      \uB41C\uB2E4. \n\uC791\uD488 \uC81C\uBAA9 \uC124\uBA85 \uC791\uAC00 \uC81C\uC791
      \uAE30\uAC04 \uC791\uD488\uC758 \uC758\uBBF8\uC640 \uC758\uB3C4 E \uD0A4\uB85C
      \uB2EB\uAE30 \uBA40\r\n\uAC00\uB098\uB2E4\uB77C\uB9C8\uBC14\uC0AC\uC544\uC790\uCC28\uCE74\uD0C0\uD30C\uD558\r\n0123456789
      .,!?()-\n\uC2E0\uC785 \uD638\uB791\uC774 \uD0D0\uC815 \uD638\uC57C\n\n\uC218\uB9CE\uC740
      \uB3D9\uBB3C\uB4E4\uACFC \uC2DD\uBB3C\uB4E4\uC774 \uC5B4\uC6B0\uB7EC\uC9C4
      \uC232\uC744 \uC9C0\uD0A4\uB294 \uB9C8\uB140.\n\uC232\uC5D0 \uC0B4\uC544\uAC00\uB294
      \uB3D9\uBB3C\uB4E4\uC744 \uCE58\uB8CC\uD558\uAC70\uB098, \n\uC695\uC2EC\uC5D0
      \uB208\uC774 \uBA4D\uB7EC \uC232\uC744 \uD574\uCE58\uB7EC \uC624\uB294 \uC778\uAC04\uB4E4\uC774
      \uB4E4\uC5B4\uC62C \uB550\n\uB9C8\uBC95\uC73C\uB85C \uB0B4\uCAD3\uC544 \uC232\uC744
      \uC9C0\uD0A8\uB2E4.\n\uAC04\uD639 \uC545\uC758\uAC00 \uC5C6\uB294 \uC778\uAC04\uB4E4\uC774
      \uC232\uC5D0 \uC798\uBABB \uBC1C\uC744 \uB4E4\uC5EC\n\uAE38\uC744 \uC783\uAE30\uB3C4
      \uD558\uBA70, \uADF8\uB7F4 \uB54C\uB9C8\uB2E4 \uBE5B\uB098\uB294 \uB9C8\uBC95\uC73C\uB85C
      \n\uAE38\uC744 \uC774\uB04C\uC5B4 \uBBF8\uC544\uAC00 \uB41C \uC0AC\uB78C\uC744
      \uC232 \uBC16\uC73C\uB85C \uC778\uB3C4\uD574\uC900\uB2E4.\n\n\uC5EC\uB7EC \uC885\uC871\uB4E4\uC774
      \uACF5\uC874\uD558\uB294 \uC138\uC0C1 \uC18D, \uC778\uAC04\uACFC \uC218\uC778\uC758
      \uD63C\uD608\uC774\uB77C\uB294\n\uC774\uC720\uB9CC\uC73C\uB85C \uCC28\uBCC4\uBC1B\uC73C\uBA70
      \uCDE8\uC9C1\uC870\uCC28 \uC27D\uC9C0 \uC54A\uC740 \uC0C1\uD669\uC5D0\n\uC5B4\uB5A0\uD55C
      \uC0B4\uC778\uC0AC\uAC74\uC5D0 \uD718\uB9D0\uB9AC\uBA70 \uC5B5\uC6B8\uD558\uAC8C
      \uB204\uBA85\uC744 \uB4A4\uC9D1\uC5B4 \uC50C\uC6CC\uC9C4 \uCC44\n\uCC28\uBCC4\uB85C
      \uC778\uD574 \uB204\uBA85\uC774 \uD480\uB9AC\uC9C0\uB3C4 \uBABB\uD558\uACE0
      \uAC10\uBC29\uC5D0 \uAC07\uD790 \uC2E0\uC138\uAC00 \uB418\uB824\uB358 \uCC30\uB098\n\uC5B4\uB5A4
      \uD0D0\uC815\uC758 \uB3C4\uC6C0\uC744 \uBC1B\uC544 \uB204\uBA85\uC744 \uD480
      \uC218 \uC788\uAC8C \uB418\uACE0\n\uB9C8\uCE68 \uD0D0\uC815\uC758 \uC870\uC218
      \uC790\uB9AC\uAC00 \uBE44\uC5B4\uC788\uB2E4\uB294 \uC18C\uC2DD\uC5D0 \uBA74\uC811\uC744
      \uBCF4\uB358 \uB3C4\uC911\n\uC6B0\uC5F0\uCE58 \uC54A\uAC8C \uB610 \uB2E4\uC2DC
      \uC0AC\uAC74\uC5D0 \uD718\uB9D0\uB9AC\uAC8C \uB41C\uB2E4.\n\uC2E0\uC785 \uD638\uB791\uC774
      \uD0D0\uC815 \uD638\uC57C \uB808\uC77C\uB77C"
